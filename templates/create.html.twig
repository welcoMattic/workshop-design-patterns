{% extends 'base.html.twig' %}

{% block content %}
    <h2>Create a new bill</h2>

    {% if errors|length > 0 %}
        <p><strong>Error(s):</strong></p>
        <ul>
            {% for error in errors %}
                <li>{{ error }}</li>
            {% endfor %}
        </ul>
    {% endif %}

    {{ form(form, {attr: {novalidate: 'novalidate'}}) }}
{% endblock %}
