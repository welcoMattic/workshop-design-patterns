{% extends 'base.html.twig' %}

{% block content %}
    <h2 class="text-2xl mb-6">Create a new bill</h2>

    {% if error %}
        <p class="text-red"><strong>Error:</strong> {{ error }}</p>
    {% endif %}

    {{ form_start(form, { attr: { novalidate: 'novalidate' } }) }}
        {{ form_row(form.id) }}
        {{ form_label(form.lines, null, { label_attr: { class: 'text-xl' } }) }}
        <div class="grid grid-cols-3 gap-4 mt-4">
            {% for formLine in form.lines %}
                {{ form_row(formLine) }}
            {% endfor %}
        </div>
        {{ form_row(form.submit, { attr: { class: 'rounded-md bg-indigo-600 px-3.5 py-2.5 text-sm font-semibold text-white shadow-xs hover:bg-indigo-500' } }) }}
    {{ form_end(form) }}
{% endblock %}
