{% extends 'base.html.twig' %}

{% block content %}
    <h2>Bill "{{ bill.id }}"</h2>
    <table>
        <thead>
        <tr>
            <th>Name</th>
            <th>Quantity</th>
            <th>Unit price</th>
            <th>Total price</th>
        </tr>
        </thead>
        <tbody>
        {% set total_in_cents = 0 %}
        {% for line in bill.lines %}
            {% set total_in_cents = total_in_cents + line.quantity * line.unit_price_in_cents %}
            <tr>
                <td>{{ line.name }}</td>
                <td>{{ line.quantity }}x</td>
                <td>{{ "%.2f %s"|format(line.unit_price_in_cents / 100, line.currency) }}</td>
                <td>{{ "%.2f %s"|format(line.quantity * line.unit_price_in_cents / 100, line.currency) }}</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <p><strong>Total</strong>: {{ bill.price }}</p>
{% endblock %}
